{
  "$comment": "Validator config. Copy and adjust per project. All paths are relative to the repository root. See README section 9 for what each key does.",

  "docs": {
    "required": ["docs/PRD.md", "docs/RFC.md", "docs/FDD.md", "docs/TRACKER.md"],
    "adrDir": "docs/adrs",
    "adrPattern": "^ADR-\\d{3}-[a-z0-9-]+\\.md$",
    "adrMin": 5,
    "adrMax": 8,
    "adrRequiredSections": ["Status", "Context", "Decis", "Alternatives", "Consequ"],
    "readme": "README.md"
  },

  "source": {
    "file": "TRANSCRIPT.md",
    "locatorPattern": "^\\[(\\d{2}:\\d{2})\\]\\s+([^:]+):",
    "locatorFormat": "[hh:mm] Name"
  },

  "tracker": {
    "header": "| ID | Document | Type | Summary | Source | Location |",
    "allowedSources": ["TRANSCRIPT", "CODE"],
    "codeSourceLabel": "CODE",
    "minCodeRows": 5,
    "minTranscriptPct": 70
  },

  "code": {
    "pathPatterns": [
      "src/[A-Za-z0-9_/.-]+\\.(ts|tsx|js|jsx)",
      "tests/[A-Za-z0-9_/.-]+\\.(ts|tsx|js|jsx)",
      "prisma/[A-Za-z0-9_/.-]+\\.prisma"
    ],
    "newPathAllowlist": ["src/worker.ts", "src/modules/webhooks/webhook.worker.ts"]
  },

  "minimums": {
    "prd": { "functionalRequirements": 8, "outOfScope": 2, "risks": 2 },
    "rfc": { "alternatives": 2, "openQuestions": 2, "adrLinks": 2 },
    "fdd": { "requestExamples": 4, "responseExamples": 4, "errorPrefix": "WEBHOOK_" },
    "readme": { "codeBlocks": 2 }
  },

  "immutable": {
    "allowOnly": ["docs/", "README.md"],
    "baseRef": null,
    "gitBinary": "git"
  }
}
