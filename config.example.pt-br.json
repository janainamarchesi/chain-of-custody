{
  "$comment": "Example config for a package written in Brazilian Portuguese. Same structure as config.example.json, with the heading/marker detection translated. This is also the config that makes the validator work against the reference case in examples/webhooks-oms.",

  "docs": {
    "required": ["docs/PRD.md", "docs/RFC.md", "docs/FDD.md", "docs/TRACKER.md"],
    "adrDir": "docs/adrs",
    "adrPattern": "^ADR-\\d{3}-[a-z0-9-]+\\.md$",
    "adrMin": 5,
    "adrMax": 8,
    "adrRequiredSections": ["Status", "Contexto", "Decis", "Alternativas Consideradas", "Consequ"],
    "readme": "README.md",
    "sections": {
      "outOfScope": "Fora de escopo",
      "openQuestions": "Quest[oõ]es em aberto",
      "observability": "Observabilidade",
      "integration": "Integra"
    },
    "markers": {
      "scopeCategories": "descartad|adiad|em aberto",
      "risk": "Probabilidade|Probability",
      "tradeoff": "Trade-off|Tradeoff",
      "request": "Request|Entrada",
      "response": "Response|Sa[ií]da",
      "obsLogs": "log",
      "obsMetrics": "m[eé]trica",
      "obsTracing": "tracing|rastreamento|trace"
    }
  },

  "source": {
    "file": "TRANSCRICAO.md",
    "locatorPattern": "^\\[(\\d{2}:\\d{2})\\]\\s+([^:]+):",
    "locatorFormat": "[hh:mm] Nome"
  },

  "tracker": {
    "header": "| ID | Documento | Tipo | Conteúdo (resumo) | Fonte | Localização |",
    "allowedSources": ["TRANSCRICAO", "CODIGO"],
    "codeSourceLabel": "CODIGO",
    "minCodeRows": 5,
    "minTranscriptPct": 70
  },

  "code": {
    "pathPatterns": [
      "src/[A-Za-z0-9_/.-]+\\.(ts|tsx|js|jsx)",
      "tests/[A-Za-z0-9_/.-]+\\.(ts|tsx|js|jsx)",
      "prisma/[A-Za-z0-9_/.-]+\\.prisma"
    ],
    "newPathAllowlist": ["src/worker.ts", "src/modules/webhooks/webhook.worker.ts"]
  },

  "minimums": {
    "prd": { "functionalRequirements": 8, "outOfScope": 2, "risks": 2 },
    "rfc": { "alternatives": 2, "openQuestions": 2, "adrLinks": 2 },
    "fdd": { "requestExamples": 4, "responseExamples": 4, "errorPrefix": "WEBHOOK_" },
    "readme": { "codeBlocks": 2 }
  },

  "immutable": {
    "allowOnly": ["docs/", "README.md"],
    "baseRef": "HEAD~6",
    "gitBinary": "git"
  }
}
